msgid ""
"WAGTAIL_LOCALIZE_DASHBOARD_TRACKED_SNIPPETS is empty. No snippet progress to "
"rebuild. Add snippet models to that setting to enable snippet tracking."
msgstr ""
"WAGTAIL_LOCALIZE_DASHBOARD_TRACKED_SNIPPETS пуст. Нет прогресса фрагментов "
"для перестройки. Добавьте модели фрагментов в этот параметр для включения "
"отслеживания."

msgid "Rebuilding translation progress for snippets..."
msgstr "Перестройка прогресса перевода для фрагментов..."

msgid "Successfully rebuilt snippet translation progress!"
msgstr "Прогресс перевода фрагментов успешно перестроен!"

msgid "The original source page"
msgstr "Исходная страница"

msgid "The translated page"
msgstr "Переведённая страница"

msgid "Percentage of segments translated (0-100)"
msgstr "Процент переведённых сегментов (0–100)"

msgid ""
"Percentage of segments translated and pushed to a live target (0-100), or "
"null if it has not been calculated yet"
msgstr ""
"Процент переведённых и опубликованных сегментов (0-100), или null, если он "
"еще не рассчитан"

msgid ""
"True when some translated segments have not been pushed to a live target."
msgstr ""
"True в том случае, если некоторые переведённые сегменты не были опубликованы."

msgid "Translation Progress"
msgstr "Прогресс перевода"

