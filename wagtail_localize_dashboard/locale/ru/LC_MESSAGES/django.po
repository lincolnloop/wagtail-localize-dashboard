msgstr[2] "Опубликовано %(count)d переводов"
msgstr[3] "Опубликовано %(count)d перевода"

msgid "Unpublish"
msgstr "Отменить публикацию"

msgid "Unpublish selected translations"
msgstr "Отменить публикацию отдельных переводов"

msgid "Are you sure you want to unpublish these translations?"
msgstr "Вы уверены, что хотите отменить публикацию этих переводов?"

msgid "Yes, unpublish"
msgstr "Да, отменить публикацию"

msgid "No, don't unpublish"
