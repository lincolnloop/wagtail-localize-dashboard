msgstr ""
"'%(object)s' не удалось опубликовать на %(locale)s языке из-за ошибок "
"валидации."

#, python-format
msgid "%(count)d translation has been published"
msgid_plural "%(count)d translations have been published"
msgstr[0] "Опубликован %(count)d перевод"
