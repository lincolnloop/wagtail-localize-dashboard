msgid "Stop syncing"
msgstr "Остановить синхронизацию"

msgid "Stop syncing selected translations"
msgstr "Остановить синхронизацию выбранных переводов"

msgid "Yes, stop syncing"
msgstr "Да, остановить синхронизацию"

msgid "No, keep syncing"
msgstr "Нет, продолжить синхронизацию"

msgid "You don't have permission to stop syncing for these:"
msgstr "Вам не разрешено останавливать синхронизацию для следующих:"

msgid "These translations are not syncing or have no page:"
msgstr "Эти переводы не синхронизируются или не имеют страницы:"

msgid ""
"Stop syncing the selected locale? Changes to the source will no longer be "
"synced to the page."
msgid_plural ""
"Stop syncing the selected locales? Changes to the source will no longer be "
"synced to the pages."
msgstr[0] ""
"Остановить синхронизацию выбранного языка? Изменения источника больше не "
"будут синхронизироваться со страницей."
msgstr[1] ""
"Остановить синхронизацию выбранных языков? Изменения источника больше не "
"будут синхронизироваться со страницами."
msgstr[2] ""
"Остановить синхронизацию выбранных языков? Изменения источника больше не "
"будут синхронизироваться со страницами."
msgstr[3] ""
"Остановить синхронизацию выбранных языков? Изменения источника больше не "
"будут синхронизироваться со страницами."

#, python-format
msgid "%(count)d translation has stopped syncing"
msgid_plural "%(count)d translations have stopped syncing"
msgstr[0] "Синхронизация %(count)d перевода прекращена"
msgstr[1] "Синхронизация %(count)d переводов прекращена"
msgstr[2] "Синхронизация %(count)d переводов прекращена"
msgstr[3] "Синхронизация %(count)d перевода прекращена"

msgid "Restart syncing"
msgstr "Возобновить синхронизацию"

msgid "Restart syncing selected translations"
msgstr "Возобновить синхронизацию выбранных переводов"

msgid "Yes, restart syncing"
msgstr "Да, возобновить синхронизацию"

msgid "No, don't restart syncing"
msgstr "Нет, не возобновлять синхронизацию"

msgid "You don't have permission to restart syncing for these:"
msgstr "Вам не разрешено возобновлять синхронизацию для следующих:"

msgid "These translations are already syncing or have no page:"
msgstr "Эти переводы уже синхронизируются или не имеют страницы:"

msgid ""
"Restart syncing this locale? It will open in the translation editor again, "
"and edits made to it while it was not syncing may be replaced the next time "
"it is published."
msgid_plural ""
"Restart syncing these locales? They will open in the translation editor "
"again, and edits made to them while they were not syncing may be replaced "
"the next time they are published."
msgstr[0] ""
"Возобновить синхронизацию этого языка? Он снова откроется в редакторе "
"переводов, и правки, внесённые в него, пока он не синхронизировался, могут "
"быть заменены при следующей публикации."
msgstr[1] ""
"Возобновить синхронизацию этих языков? Они снова откроются в редакторе "
"переводов, и правки, внесённые в них, пока они не синхронизировались, могут "
"быть заменены при следующей публикации."
msgstr[2] ""
"Возобновить синхронизацию этих языков? Они снова откроются в редакторе "
"переводов, и правки, внесённые в них, пока они не синхронизировались, могут "
"быть заменены при следующей публикации."
msgstr[3] ""
"Возобновить синхронизацию этих языков? Они снова откроются в редакторе "
"переводов, и правки, внесённые в них, пока они не синхронизировались, могут "
"быть заменены при следующей публикации."

#, python-format
msgid "%(count)d translation has restarted syncing"
msgid_plural "%(count)d translations have restarted syncing"
msgstr[0] "Синхронизация %(count)d перевода возобновлена"
msgstr[1] "Синхронизация %(count)d переводов возобновлена"
msgstr[2] "Синхронизация %(count)d переводов возобновлена"
msgstr[3] "Синхронизация %(count)d перевода возобновлена"

